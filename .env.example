# Example environment file - Copy to .env and fill in with your values

# OpenAI Configuration
OPENAI_API_KEY=sk_test_your_key_here

# Environment
PYTHON_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:4200

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database (Optional)
# DATABASE_URL=sqlite:///./db/documents.db

# Logging
LOG_LEVEL=INFO

# Security
ALLOW_ORIGINS=http://localhost:4200,http://localhost:3000

# Document Processing
MAX_FILE_SIZE=50000000
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Vector Database
VECTOR_DB_PATH=./db
FAISS_INDEX_PATH=./db/faiss_index
